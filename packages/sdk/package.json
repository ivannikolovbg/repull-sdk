{
  "name": "@repull/sdk",
  "version": "0.2.48",
  "description": "Official TypeScript SDK for Repull — one API for Airbnb, Booking.com, Vrbo and 14 PMS platforms.",
  "license": "SEE LICENSE.md",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repull/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "keywords": [
    "repull",
    "vacation-rental",
    "airbnb",
    "booking",
    "vrbo",
    "channel-manager",
    "pms",
    "sdk"
  ]
}
